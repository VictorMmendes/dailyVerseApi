module Knowledge
  module Books
    class CreateBook
      # -----------------------------------------------------------
      # 1. Definições das Classes de Resultado Aninhadas
      # -----------------------------------------------------------

      # A classe Success deve encapsular um objeto Book.
      class Success
        @value: Book

        attr_reader value: Book

        def initialize: (Book value) -> void

        def success?: () -> true

        def failure?: () -> false
      end

      # A classe Failure deve encapsular um Hash de erros.
      class Failure
        # O Hash de erros é tipicamente { String | Symbol => Array[String] | String }
        @errors: Hash[Symbol, Array[String]]

        attr_reader errors: Hash[Symbol, Array[String]]

        def initialize: (Hash[Symbol, Array[String]] errors) -> void

        def success?: () -> false

        def failure?: () -> true
      end

      # -----------------------------------------------------------
      # 2. Definições da Classe Principal (Command)
      # -----------------------------------------------------------

      # Define um tipo de retorno (Result) que é a união de Success ou Failure
      type result_t = Success | Failure

      # Referência ao Form Object usado (deve ser um tipo que existe em sig/)
      @form: BookForm

      # Método de classe `self.call`
      def self.call: (Hash[Symbol, untyped] params) -> result_t

      # Construtor
      # O parâmetro params é o Hash de entrada que será passado para o Form
      def initialize: (Hash[Symbol, untyped] params) -> void

      # Método de instância `call`
      # Retorna o tipo de resultado definido
      def call: () -> result_t

      # -----------------------------------------------------------
      # 3. Referências Externas (Opcional, mas útil)
      # -----------------------------------------------------------

      # Os tipos abaixo são de classes que o Command usa,
      # mas que devem ter seus próprios arquivos RBS (Book, BookForm).
      # Book: Knowledge::Books::Book
      # BookForm: Knowledge::Books::Forms::BookForm
    end
  end
end